# URL de l'API backend (local, Railway, etc.)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optionnel : même valeur que API_SECRET_KEY côté backend si tu actives la protection
# des routes sensibles (moteur, clés exchange). Exposé dans le bundle navigateur :
# à réserver aux environnements de confiance / dev.
# NEXT_PUBLIC_TRADING_IA_API_KEY=your_api_secret_key_here
